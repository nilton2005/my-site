---
// Panel opcional dentro de un párrafo: una palabra (la «etiqueta») que al pasar el ratón, o al tocarla, despliega
// historia, curiosidades o ejemplos. Cientos de dígitos hexadecimales vuelan y se juntan hasta formar el texto.
// Así el artículo no se sobrecarga: quien quiere leerlo lo abre, quien no, sigue de largo.
//
//   <Dato etiqueta="historia" titulo="Historia de SHA-1" items={["<strong>1995.</strong> …", "…"]} />
//
// - `items` admite HTML en línea (<strong>, <code>, <sup>): cada uno es un renglón del panel.
// - El texto está siempre en el HTML (lo leen lectores de pantalla y buscadores); la animación solo lo decora.
// - Ratón: se abre al pasar el cursor; un clic lo fija. Táctil y teclado: Enter / toque lo abre; Esc o fuera lo cierra.
// - Con «reducir movimiento» el texto aparece sin animación.
import { idiomaDe, UI } from "../i18n";

interface Props {
  etiqueta: string;
  titulo: string;
  items: string[];
}

const { etiqueta, titulo, items } = Astro.props;
const t = UI[idiomaDe(Astro.currentLocale)].dato;
const id = `dato-${Math.random().toString(36).slice(2, 8)}`;
---

<span class="dato" data-dato>
  <button type="button" class="dato-boton" aria-expanded="false" aria-controls={id}>{etiqueta}</button>
  <span class="dato-panel" id={id} role="group" aria-label={titulo} tabindex="-1" hidden>
    <canvas class="dato-lienzo" aria-hidden="true"></canvas>
    <span class="dato-cuerpo">
      <span class="dato-cabecera">
        <span class="dato-titulo">{titulo}</span>
        <button type="button" class="dato-cerrar" aria-label={t.cerrar}>×</button>
      </span>
      {items.map((item) => <span class="dato-item" set:html={item} />)}
    </span>
  </span>
</span>

<script>
  const GLIFOS = "0123456789abcdef";
  const DURACION = 1300; // ms que tardan los dígitos en juntarse
  const MARGEN = 70; // el lienzo sobresale del panel para que los dígitos vengan de fuera
  const MAX_PARTICULAS = 320;
  const PADDING_VERTICAL = 30; // padding de arriba + abajo del panel (ver el CSS)
  const reducir = matchMedia("(prefers-reduced-motion: reduce)");

  interface Dato {
    raiz: HTMLElement;
    boton: HTMLButtonElement;
    panel: HTMLElement;
    lienzo: HTMLCanvasElement;
    cuerpo: HTMLElement;
    fijo: boolean;
    temporizador?: number;
    cuadro?: number;
  }

  const datos: Dato[] = [...document.querySelectorAll<HTMLElement>("[data-dato]")].map((raiz) => ({
    raiz,
    boton: raiz.querySelector<HTMLButtonElement>(".dato-boton")!,
    panel: raiz.querySelector<HTMLElement>(".dato-panel")!,
    lienzo: raiz.querySelector<HTMLCanvasElement>(".dato-lienzo")!,
    cuerpo: raiz.querySelector<HTMLElement>(".dato-cuerpo")!,
    fijo: false,
  }));
  let abierto: Dato | undefined;
  let pendiente = false;

  const aleatorio = (a: number, b: number) => a + Math.random() * (b - a);
  const limitar = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));
  const suave = (x: number) => 1 - Math.pow(1 - x, 4); // easeOutQuart

  /** Coloca el panel bajo la palabra (o encima si abajo no cabe) sin salirse de la pantalla. */
  function colocar(d: Dato) {
    const r = d.boton.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) return cerrar(d);
    const ancho = Math.min(500, innerWidth - 24);
    d.panel.style.width = `${ancho}px`;
    d.cuerpo.style.maxHeight = "";
    d.cuerpo.classList.remove("desborda");
    let alto = d.panel.offsetHeight;
    // Se abre del lado con más espacio; si no cabe en ninguno, el cuerpo se desplaza dentro del panel.
    const abajo = innerHeight - r.bottom - 22;
    const encima = r.top - 22;
    const haciaAbajo = alto <= abajo || abajo >= encima;
    const espacio = haciaAbajo ? abajo : encima;
    if (alto > espacio) {
      alto = Math.max(160, espacio);
      d.cuerpo.style.maxHeight = `${alto - PADDING_VERTICAL}px`;
      d.cuerpo.classList.add("desborda");
    }
    const izquierda = limitar(r.left, 12, innerWidth - ancho - 12);
    const arriba = haciaAbajo ? r.bottom + 10 : Math.max(12, r.top - 10 - alto);
    d.panel.style.left = `${izquierda}px`;
    d.panel.style.top = `${arriba}px`;
  }

  /** Centro de cada letra visible del panel, relativo a la esquina del lienzo. */
  function objetivos(d: Dato, origen: DOMRect): { x: number; y: number }[] {
    const puntos: { x: number; y: number }[] = [];
    const recorrido = document.createTreeWalker(d.cuerpo, NodeFilter.SHOW_TEXT);
    const rango = document.createRange();
    for (let nodo = recorrido.nextNode(); nodo; nodo = recorrido.nextNode()) {
      const texto = nodo.textContent ?? "";
      for (let i = 0; i < texto.length; i++) {
        if (/\s/.test(texto[i]!)) continue;
        rango.setStart(nodo, i);
        rango.setEnd(nodo, i + 1);
        const c = rango.getClientRects()[0];
        // Las letras que quedan fuera del panel (cuerpo con desplazamiento) no se dibujan.
        if (c && c.top >= origen.top && c.bottom <= origen.bottom) puntos.push({ x: c.left + c.width / 2 - origen.left + MARGEN, y: c.top + c.height / 2 - origen.top + MARGEN });
      }
    }
    // Muestra pareja: así los dígitos dibujan todo el texto, no solo el principio.
    const paso = Math.max(1, puntos.length / MAX_PARTICULAS);
    return Array.from({ length: Math.min(MAX_PARTICULAS, puntos.length) }, (_, i) => puntos[Math.floor(i * paso)]!);
  }

  function animar(d: Dato) {
    const ctx = d.lienzo.getContext("2d");
    if (!ctx) return d.panel.classList.add("listo");
    const caja = d.panel.getBoundingClientRect();
    const ancho = caja.width + MARGEN * 2;
    const alto = caja.height + MARGEN * 2;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    d.lienzo.width = Math.round(ancho * dpr);
    d.lienzo.height = Math.round(alto * dpr);
    d.lienzo.style.width = `${ancho}px`;
    d.lienzo.style.height = `${alto}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.font = '600 11px ui-monospace, "Cascadia Code", Menlo, Consolas, monospace';
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    const color = getComputedStyle(d.panel).getPropertyValue("--accent").trim() || "#f3ca47";

    const particulas = objetivos(d, caja).map((destino) => ({
      x0: aleatorio(0, ancho),
      y0: aleatorio(0, alto),
      x1: destino.x,
      y1: destino.y,
      curva: aleatorio(-40, 40),
      retraso: aleatorio(0, 420),
      glifo: GLIFOS[Math.floor(Math.random() * 16)]!,
    }));

    d.panel.classList.add("animando");
    const inicio = performance.now();
    let revelado = false;
    const cuadro = (ahora: number) => {
      const t = ahora - inicio;
      ctx.clearRect(0, 0, ancho, alto);
      ctx.fillStyle = color;
      for (const p of particulas) {
        const avance = limitar((t - p.retraso) / (DURACION - 420), 0, 1);
        if (avance <= 0) continue;
        const e = suave(avance);
        const x = p.x0 + (p.x1 - p.x0) * e + Math.sin(avance * Math.PI) * p.curva;
        const y = p.y0 + (p.y1 - p.y0) * e + Math.sin(avance * Math.PI) * -p.curva * 0.6;
        // Aparecen, viajan cambiando de dígito como datos en movimiento y se disuelven al llegar.
        const alfa = avance < 0.12 ? avance / 0.12 : avance > 0.78 ? Math.max(0, 1 - (avance - 0.78) / 0.22) : 1;
        if (avance < 0.85 && Math.random() < 0.06) p.glifo = GLIFOS[Math.floor(Math.random() * 16)]!;
        ctx.globalAlpha = alfa * 0.9;
        ctx.fillText(p.glifo, x, y);
      }
      ctx.globalAlpha = 1;
      if (!revelado && t > DURACION * 0.5) {
        revelado = true;
        d.panel.classList.add("listo"); // el texto real se funde mientras los dígitos terminan de llegar
      }
      if (t < DURACION + 420) d.cuadro = requestAnimationFrame(cuadro);
      else {
        ctx.clearRect(0, 0, ancho, alto);
        d.panel.classList.remove("animando");
        d.cuadro = undefined;
      }
    };
    d.cuadro = requestAnimationFrame(cuadro);
  }

  function abrir(d: Dato, fijar: boolean) {
    if (abierto === d) {
      if (fijar) d.fijo = true;
      return;
    }
    if (abierto) cerrar(abierto);
    clearTimeout(d.temporizador);
    abierto = d;
    d.fijo = fijar;
    d.panel.hidden = false;
    d.raiz.classList.add("abierto");
    d.boton.setAttribute("aria-expanded", "true");
    colocar(d);
    if (reducir.matches) d.panel.classList.add("listo");
    else animar(d);
  }

  function cerrar(d: Dato) {
    clearTimeout(d.temporizador);
    if (d.cuadro) cancelAnimationFrame(d.cuadro);
    d.cuadro = undefined;
    d.fijo = false;
    d.panel.hidden = true;
    d.panel.classList.remove("listo", "animando");
    d.raiz.classList.remove("abierto");
    d.boton.setAttribute("aria-expanded", "false");
    if (abierto === d) abierto = undefined;
  }

  for (const d of datos) {
    // Ratón: se abre al pasar (con una pequeña espera para no disparar al cruzar) y se cierra al salir.
    d.raiz.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return;
      clearTimeout(d.temporizador);
      if (abierto !== d) d.temporizador = window.setTimeout(() => abrir(d, false), 120);
    });
    d.raiz.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return;
      clearTimeout(d.temporizador);
      if (!d.fijo) d.temporizador = window.setTimeout(() => cerrar(d), 260);
    });
    // Clic o toque: abre y fija; otro clic en la palabra lo cierra.
    d.boton.addEventListener("click", () => {
      if (abierto === d && d.fijo) cerrar(d);
      else abrir(d, true);
    });
    d.raiz.querySelector(".dato-cerrar")!.addEventListener("click", () => {
      cerrar(d);
      d.boton.focus();
    });
    // Con teclado: al salir el foco del panel y de la palabra, se cierra.
    d.raiz.addEventListener("focusout", (e) => {
      const hacia = e.relatedTarget as Node | null;
      if (abierto === d && d.fijo && hacia && !d.raiz.contains(hacia)) cerrar(d);
    });
  }

  addEventListener("pointerdown", (e) => {
    if (abierto && !abierto.raiz.contains(e.target as Node)) cerrar(abierto);
  });
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && abierto) {
      const d = abierto;
      cerrar(d);
      d.boton.focus();
    }
  });
  const reajustar = () => {
    if (pendiente || !abierto) return;
    pendiente = true;
    requestAnimationFrame(() => {
      pendiente = false;
      if (abierto) colocar(abierto);
    });
  };
  addEventListener("scroll", reajustar, { passive: true });
  addEventListener("resize", reajustar);
</script>

<style>
  .dato {
    display: inline;
  }
  .dato-boton {
    padding: 0 2px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--accent);
    font: inherit;
    text-decoration: underline dotted;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    cursor: pointer;
    transition: background-color 0.2s var(--ease);
  }
  .dato-boton:hover,
  .dato.abierto .dato-boton {
    background: var(--accent-soft);
  }
  .dato-boton:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .dato-panel {
    position: fixed;
    z-index: 30;
    display: block;
    box-sizing: border-box;
    padding: 14px 18px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow), 0 18px 40px -16px #00000066;
    color: var(--text);
    font-size: 15px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.55;
    text-align: left;
    text-wrap: pretty;
    animation: dato-entrada 0.22s var(--ease);
    outline: none;
  }
  .dato-panel[hidden] {
    display: none;
  }
  @keyframes dato-entrada {
    from {
      opacity: 0;
      transform: translateY(4px) scale(0.98);
    }
  }

  /* los dígitos vuelan por encima del panel y sobresalen de él */
  .dato-lienzo {
    position: absolute;
    inset: -70px;
    z-index: 1;
    pointer-events: none;
  }
  .dato-cuerpo {
    display: block;
    position: relative;
    transition: opacity 0.55s var(--ease), filter 0.55s var(--ease);
  }
  .dato-cuerpo.desborda {
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  /* mientras los dígitos se juntan, el texto real espera; sin JS o sin animación se ve siempre */
  .dato-panel.animando:not(.listo) .dato-cuerpo {
    opacity: 0;
    filter: blur(3px);
  }
  .dato-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }
  .dato-titulo {
    color: var(--accent);
    font: 600 12px/1.4 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .dato-cerrar {
    width: 28px;
    height: 28px;
    margin: -6px -8px -6px 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    font: 400 20px/1 var(--font-sans);
    cursor: pointer;
  }
  .dato-cerrar:hover {
    background: var(--accent-soft);
    color: var(--strong);
  }
  .dato-item {
    display: block;
    position: relative;
    padding: 6px 0 6px 16px;
    border-top: 1px solid var(--line);
  }
  .dato-item::before {
    content: "›";
    position: absolute;
    left: 2px;
    color: var(--accent);
    font-weight: 700;
  }
  .dato-item :global(strong) {
    color: var(--strong);
  }
  .dato-panel .dato-item :global(code) {
    padding: 0.08em 0.32em;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--code-bg);
    color: var(--strong);
    font-size: 0.88em;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  /* sin JavaScript no hay botones que abrir: el contenido se muestra como un bloque más */
  @media (scripting: none) {
    .dato-panel,
    .dato-panel[hidden] {
      position: static;
      display: block;
      width: auto;
      margin: 8px 0;
      animation: none;
    }
    .dato-lienzo,
    .dato-cerrar {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dato-panel {
      animation: none;
    }
  }
</style>
