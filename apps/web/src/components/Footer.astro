---
import { AUTHOR } from "../config";
import { idiomaDe, RUTAS, UI } from "../i18n";

const idioma = idiomaDe(Astro.currentLocale);
const year = new Date().getFullYear();
---

<footer class="pie">
  <p>© {year} {AUTHOR.name}</p>
  <p class="enlaces">
    {AUTHOR.github && <a href={AUTHOR.github} rel="me">GitHub</a>}
    {AUTHOR.linkedin && <a href={AUTHOR.linkedin} rel="me">LinkedIn</a>}
    <a href={RUTAS[idioma].rss}>RSS</a>
  </p>
  <p class="hecho">{UI[idioma].pie.hecho}</p>
  <p class="sello" aria-hidden="true"><img src="/mokya-logo.png" alt="" width="14" height="13" />mokya</p>
</footer>

<style>
  .pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    width: min(var(--wide), 100%);
    margin: 96px auto 0;
    padding: 28px var(--gutter) 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }
  .pie p {
    margin: 0;
  }
  .enlaces {
    display: flex;
    gap: 16px;
  }
  .enlaces a {
    color: var(--text);
  }
  .sello {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    opacity: 0.45;
  }
  .sello img {
    width: 14px;
    height: auto;
  }
  .hecho {
    width: 100%;
    font-family: var(--font-mono);
    font-size: 12px;
  }
</style>
