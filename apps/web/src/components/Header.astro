---
const path = Astro.url.pathname;
const enlaces = [
  { href: "/", texto: "Quién soy", activo: path === "/" },
  { href: "/diario/", texto: "Diario", activo: path.startsWith("/diario") },
];
---

<header class="cabecera">
  <a class="marca" href="/" aria-label="Nilton Taco, inicio">
    <span class="prompt" aria-hidden="true">~/</span>nilton-taco<span class="cursor" aria-hidden="true"></span>
  </a>
  <nav aria-label="Principal">
    {enlaces.map((e) => <a href={e.href} aria-current={e.activo ? "page" : undefined}>{e.texto}</a>)}
    <button class="buscar" type="button" data-abrir-paleta aria-label="Buscar (Ctrl K)" title="Buscar">
      <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m16 16 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      <kbd data-atajo>Ctrl K</kbd>
    </button>
    <a class="icono" href="/rss.xml" title="RSS del diario" aria-label="RSS del diario">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 19a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm-1-8a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </a>
    <button class="icono" type="button" data-cambiar-tema aria-label="Cambiar entre tema claro y oscuro" title="Tema claro / oscuro">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" /></svg>
    </button>
  </nav>
</header>

<style>
  .cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(var(--wide), 100%);
    margin: 0 auto;
    padding: 20px var(--gutter);
  }
  .marca {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--strong);
    text-decoration: none;
    white-space: nowrap;
  }
  .prompt {
    color: var(--accent);
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.18em;
    background: var(--accent);
    animation: parpadeo 1.1s steps(1, end) infinite;
  }
  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  nav a,
  nav button {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--text);
    font: 500 14px/1 var(--font-sans);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  nav a:hover,
  nav button:hover {
    color: var(--strong);
    background: var(--surface);
  }
  nav a[aria-current="page"] {
    color: var(--strong);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .icono {
    padding: 0 9px;
  }
  .buscar {
    gap: 8px;
    margin: 0 4px;
    border: 1px solid var(--line) !important;
    color: var(--muted) !important;
  }
  .buscar kbd {
    padding: 1px 6px;
    border: 1px solid var(--line);
    border-radius: 5px;
    font: 500 11px/1.4 var(--font-mono);
  }
  @media (max-width: 640px) {
    .buscar kbd {
      display: none;
    }
  }
  @media (max-width: 420px) {
    .cabecera {
      gap: 8px;
    }
    .marca {
      font-size: 14px;
    }
    .cursor {
      display: none;
    }
    nav a,
    nav button {
      padding: 0 8px;
    }
  }
</style>
