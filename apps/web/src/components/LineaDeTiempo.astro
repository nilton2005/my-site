---
// Línea de tiempo de una serie: todas las partes en orden, con el hilo de la historia, las ramas de cada parte
// y el estado real (publicado, borrador o próximamente). Los datos salen de src/series.ts.
//   <LineaDeTiempo serie="git-por-dentro" idioma="es" actual="donde-guarda-git" />
//   <LineaDeTiempo serie="git-por-dentro" idioma="es" compacta />   ← solo títulos (portada)
import { UI, type Idioma } from "../i18n";
import { resolverSerie, type ItemSerie } from "../lib/serie";

interface Props {
  serie: string;
  idioma: Idioma;
  /** `id` del artículo que se está leyendo, para marcarlo. */
  actual?: string;
  compacta?: boolean;
}

const { serie, idioma, actual, compacta = false } = Astro.props;
const t = UI[idioma].articulo;
const partes = await resolverSerie(serie, idioma);
const esActual = (i: ItemSerie) => !!actual && i.id === actual;
// Una parte está «activa» si es la que se lee o si se lee una de sus ramas.
const activa = (p: (typeof partes)[number]) => esActual(p) || p.ramas.some(esActual);
const etiqueta = (i: ItemSerie) => (esActual(i) ? t.estasAqui : i.estado === "proximamente" ? t.proximamente : i.estado === "borrador" ? t.borrador : "");
---

<ol class:list={["tiempo", { compacta }]}>
  {
    partes.map((p) => (
      <li class:list={["parte", p.estado, { activa: activa(p) }]}>
        <span class="punto" aria-hidden="true" />
        <p class="num">{t.parte} {String(p.orden).padStart(2, "0")}</p>
        <p class="titulo">
          {p.url ? <a href={p.url} aria-current={esActual(p) ? "page" : undefined}>{p.titulo}</a> : <span>{p.titulo}</span>}
          {etiqueta(p) && <span class:list={["etiqueta", { aqui: esActual(p) }]}>{etiqueta(p)}</span>}
        </p>
        {!compacta && <p class="hilo">{p.hilo}</p>}
        {
          !compacta && p.ramas.length > 0 && (
            <ul class="ramas-serie">
              {p.ramas.map((r) => (
                <li class:list={[r.estado, { activa: esActual(r) }]}>
                  <span class="rama-marca" aria-hidden="true">↳</span>
                  <span class="rama-texto">
                    {r.url ? <a href={r.url} aria-current={esActual(r) ? "page" : undefined}>{r.titulo}</a> : <span>{r.titulo}</span>}
                    {etiqueta(r) && <span class:list={["etiqueta", { aqui: esActual(r) }]}>{etiqueta(r)}</span>}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </li>
    ))
  }
</ol>

<style>
  .tiempo {
    --linea: var(--line-strong, var(--line));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .parte {
    position: relative;
    padding: 0 0 20px 30px;
  }
  .parte:last-child {
    padding-bottom: 0;
  }
  /* la línea vertical que une las partes */
  .parte::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 16px;
    bottom: -2px;
    width: 2px;
    background: var(--linea);
  }
  .parte:last-child::before {
    display: none;
  }
  .punto {
    position: absolute;
    left: 0;
    top: 3px;
    width: 14px;
    height: 14px;
    box-sizing: border-box;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--accent);
  }
  .parte.proximamente .punto {
    border-color: var(--linea);
    background: var(--page);
  }
  .parte.borrador .punto {
    background: var(--page);
    border-style: dashed;
  }
  .parte.activa .punto {
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .num {
    margin: 0 0 2px;
    color: var(--muted);
    font: 600 12px/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .parte.activa .num {
    color: var(--accent);
  }
  .titulo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0;
    color: var(--strong);
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.4;
  }
  .parte.proximamente > .titulo {
    color: var(--muted);
    font-weight: 500;
  }
  .titulo a {
    color: inherit;
  }
  .etiqueta {
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font: 500 11.5px/1.7 var(--font-mono);
    white-space: nowrap;
  }
  .etiqueta.aqui {
    border-color: transparent;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .hilo {
    margin: 4px 0 0;
    color: var(--text);
    font-size: 14.5px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .parte.proximamente > .hilo {
    color: var(--muted);
  }

  /* ramas de una parte */
  .ramas-serie {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .ramas-serie li {
    display: flex;
    gap: 8px;
    padding: 2px 0;
    font-size: 14px;
    line-height: 1.5;
  }
  .rama-marca {
    color: var(--muted);
  }
  .rama-texto {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }
  .ramas-serie li.proximamente {
    color: var(--muted);
  }
  .ramas-serie li.activa a {
    color: var(--accent);
    font-weight: 600;
  }

  /* versión compacta (portada): solo número y título */
  .compacta .parte {
    padding-bottom: 12px;
  }
  .compacta .num {
    display: inline;
    margin-right: 8px;
  }
  .compacta .parte {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 10px;
  }
  .compacta .titulo {
    font-size: 15px;
  }
  .compacta .num {
    margin: 0;
  }
</style>
