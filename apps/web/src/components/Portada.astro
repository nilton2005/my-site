---
// Portada del artículo: una escena de naturaleza hecha de partículas (src/lib/portadas.mjs) que representa el tema
// sin decirlo. Es SVG estático generado al compilar: sin JavaScript, y cambia con el tema claro/oscuro.
// Es decorativa (el título ya dice de qué trata), así que los lectores de pantalla la saltan.
import { portadaBanner } from "../lib/portadas.mjs";

interface Props {
  /** Carpeta del artículo (su id). Sin escena registrada, no dibuja nada. */
  id: string;
}

const svg = portadaBanner(Astro.props.id);
---

{svg && <div class="portada-articulo" aria-hidden="true" set:html={svg} />}

<style>
  .portada-articulo {
    position: relative;
    isolation: isolate;
    margin-block: 4px 32px;
    inline-size: 100%;
  }
  .portada-articulo::before {
    content: "";
    position: absolute;
    inset: 4% 8%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--brand) 14%, transparent) 0%,
      color-mix(in srgb, var(--brand) 4%, transparent) 55%,
      transparent 100%
    );
    pointer-events: none;
  }
  :global(:root[data-theme="dark"]) .portada-articulo::before {
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--brand) 10%, transparent) 0%,
      color-mix(in srgb, var(--brand) 3%, transparent) 56%,
      transparent 100%
    );
  }
  .portada-articulo :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    max-block-size: clamp(220px, 42vw, 340px);
    /* Los cuatro bordes se funden con la página, igual que el mono de la portada */
    mask-image:
      linear-gradient(to right, transparent, #000 10%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    mask-composite: intersect;
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 10%, #000 92%, transparent),
      linear-gradient(to bottom, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-composite: source-in;
  }
  @media (prefers-reduced-motion: no-preference) {
    .portada-articulo {
      animation: entrar-portada 0.55s var(--ease) both;
    }
  }
  @keyframes entrar-portada {
    from {
      opacity: 0;
      translate: 0 8px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
