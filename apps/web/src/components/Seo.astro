---
import { SITE } from "../config";
import { idiomaDe, otroIdioma, RUTAS, UI } from "../i18n";

interface Props {
  title: string;
  description: string;
  /** URL absoluta de la imagen para redes (1200 × 630). */
  image: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Ruta de esta misma página en el otro idioma. */
  alternate?: string | undefined;
}

const { title, description, image, imageAlt = title, type = "website", publishedTime, modifiedTime, jsonLd, alternate } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const idioma = idiomaDe(Astro.currentLocale);
const otro = otroIdioma(idioma);
const urlOtro = alternate ? new URL(alternate, Astro.site).href : undefined;
const urlEs = idioma === "es" ? canonical : urlOtro;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{
  urlOtro && (
    <>
      <link rel="alternate" hreflang={idioma} href={canonical} />
      <link rel="alternate" hreflang={otro} href={urlOtro} />
      <link rel="alternate" hreflang="x-default" href={urlEs} />
    </>
  )
}
<meta name="author" content={SITE.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={UI[idioma].sitio.locale} />
<meta property="og:locale:alternate" content={UI[otro].sitio.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<link rel="alternate" type="application/rss+xml" title={`${UI[idioma].diario.rss} · ${SITE.name}`} href={new URL(RUTAS[idioma].rss, Astro.site)} />
<link rel="sitemap" href="/sitemap-index.xml" />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
