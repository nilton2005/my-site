---
// Dice, de un vistazo, DÓNDE estás dentro de una serie. Tiene dos modos:
//  · "cabecera" (arriba del título): una sola franja limpia (sin duplicar breadcrumb ni apilar enlaces).
//    En artículo principal: «Diario / Serie · Parte 01 de 08» + mini progreso en línea.
//    En subartículo: «↩ Subartículo de Parte 01 · Volver a <artículo padre>» + enlace al mapa.
//  · "pie" (al final): única tarjeta clara de «Siguiente parte» o «Vuelve a donde lo dejaste».
import { RUTAS, UI, type Idioma } from "../i18n";
import { ubicar } from "../lib/serie";
import { urlSerie } from "../series";

interface Props {
  serie: string;
  idioma: Idioma;
  actual: string;
  modo: "cabecera" | "pie";
}

const { serie, idioma, actual, modo } = Astro.props;
const t = UI[idioma].serie;
const rutas = RUTAS[idioma];
const u = await ubicar(serie, idioma, actual);
const mapa = urlSerie(serie, idioma);
const num = (n: number) => String(n).padStart(2, "0");

// Mini progreso: una sola fila compacta de puntos para la cabecera.
const PASO = 16;
const nodos = u ? u.partes.map((p, i) => ({ x: 9 + i * PASO, p, actual: p.id === actual })) : [];
const ancho = u ? 18 + (u.partes.length - 1) * PASO : 0;
const alto = 18;
const volver = u ? (u.parte.url ? `${u.parte.url}#pausa` : undefined) : undefined;
---

{
  u && modo === "cabecera" && (
    <nav class:list={["ubic-linea", { sub: !!u.sub }]} aria-label={t.posicion} data-pagefind-ignore>
      {u.sub ? (
        <div class="sub-fila">
          <span class="sub-etiqueta">
            {t.subarticulo} {t.subDe} {num(u.parte.orden)}
          </span>
          {volver && (
            <a class="volver" href={volver}>
              ↩ {t.volverCorta} «{u.parte.titulo}»
            </a>
          )}
          <a class="mapa-link" href={mapa}>
            {t.verMapa}
          </a>
        </div>
      ) : (
        <div class="parte-fila">
          <p class="ruta">
            <a href={rutas.diario}>{UI[idioma].nav.diario}</a>
            <span aria-hidden="true">/</span>
            <a href={mapa}>{u.nombre}</a>
            <span aria-hidden="true">·</span>
            <span class="paso">
              {t.parte} {num(u.parte.orden)} {t.de} {num(u.total)}
            </span>
          </p>
          <a class="glifo" href={mapa} aria-label={t.verMapa} title={t.verMapa}>
            <svg width={ancho} height={alto} viewBox={`0 0 ${ancho} ${alto}`} aria-hidden="true">
              {nodos.slice(1).map((n, i) => (
                <line x1={nodos[i]!.x} y1="9" x2={n.x} y2="9" class:list={["tramo", { hecho: n.p.estado === "publicado" }]} />
              ))}
              {nodos.map((n) => (
                <circle cx={n.x} cy="9" r={n.actual ? 5 : 3.4} class:list={["nodo", n.p.estado, { aqui: n.actual }]} />
              ))}
            </svg>
          </a>
        </div>
      )}
    </nav>
  )
}

{
  u && modo === "pie" && (u.sub || u.siguiente) && (
    <aside class="pie" data-pagefind-ignore>
      {u.sub ? (
        <>
          <p class="rotulo">{t.terminasteSub}</p>
          {volver ? (
            <a class="gran" href={volver}>
              ↩ {t.parte} {num(u.parte.orden)} · {u.parte.titulo}
            </a>
          ) : (
            <p class="gran">{u.parte.titulo}</p>
          )}
        </>
      ) : (
        u.siguiente && (
          <>
            <p class="rotulo">
              {t.siguienteParte} · {t.parte} {num(u.siguiente.orden)}
            </p>
            {u.siguiente.url ? (
              <a class="gran" href={u.siguiente.url}>
                {u.siguiente.titulo} →
              </a>
            ) : (
              <p class="gran pronto">{u.siguiente.titulo}</p>
            )}
            {(!u.siguiente.url || u.siguiente.estado === "avance") && (
              <span class="etiqueta">{u.siguiente.url ? t.avance : t.proximamente}</span>
            )}
            <p class="hilo">{u.siguiente.hilo}</p>
          </>
        )
      )}
    </aside>
  )
}

<style>
  /* ── cabecera compacta en una sola franja ── */
  .ubic-linea {
    margin-block-end: 16px;
  }
  .parte-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .ruta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ruta a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .ruta a:hover {
    color: var(--accent);
  }
  .paso {
    color: var(--accent);
    font-weight: 600;
  }
  .sub-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-inline-start: 3px dashed var(--accent);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 14px;
  }
  .sub-etiqueta {
    color: var(--accent);
    font: 600 11.5px / 1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .volver {
    font-weight: 600;
    color: var(--strong);
  }
  .mapa-link {
    margin-inline-start: auto;
    font: 500 12.5px / 1.4 var(--font-mono);
    color: var(--muted);
  }
  .mapa-link:hover {
    color: var(--accent);
  }
  .glifo {
    flex: none;
    line-height: 0;
    color: var(--accent);
  }
  .glifo:hover svg {
    filter: drop-shadow(0 0 4px var(--accent-soft));
  }
  .tramo {
    stroke: var(--line-strong);
    stroke-width: 1.8;
    stroke-dasharray: 2.5 2.5;
  }
  .tramo.hecho {
    stroke: var(--accent);
    stroke-dasharray: none;
  }
  .nodo {
    stroke-width: 1.8;
    stroke: var(--accent);
    fill: var(--accent);
  }
  .nodo.proximamente {
    stroke: var(--line-strong);
    fill: var(--page);
  }
  .nodo.borrador,
  .nodo.avance {
    stroke-dasharray: 2 1.5;
    fill: var(--page);
  }
  .nodo.aqui {
    stroke-width: 2.6;
    fill: var(--page);
  }

  /* ── pie: único siguiente paso claro ── */
  .pie {
    margin-block-start: 44px;
    padding: 20px 24px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .pie .rotulo {
    margin: 0 0 6px;
    color: var(--accent);
  }
  .gran {
    display: inline-block;
    margin: 0;
    color: var(--strong);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .gran.pronto {
    color: var(--muted);
    font-weight: 600;
  }
  .etiqueta {
    margin-inline-start: 10px;
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font: 500 11.5px / 1.7 var(--font-mono);
    vertical-align: 2px;
  }
  .hilo {
    margin: 6px 0 0;
    color: var(--text);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (max-width: 560px) {
    .mapa-link {
      margin-inline-start: 0;
    }
  }
</style>
