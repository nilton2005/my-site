---
import "@fontsource/special-elite/latin-400.css";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import HeroMono from "../HeroMono.astro";
import MapaSerie from "../MapaSerie.astro";
import { AUTHOR, PERFILES, SITE } from "../../config";
import { idiomaDe, otroIdioma, RUTAS, UI } from "../../i18n";
import { fechaIso, fechaLarga, getArticulos, minutosDeLectura, urlDe } from "../../lib/diario";
import { urlSerie } from "../../series";

const idioma = idiomaDe(Astro.currentLocale);
const t = UI[idioma].inicio;
// Un avance (solo el comienzo) no es «lo último del diario» ni cuenta en los números.
const articulos = (await getArticulos(idioma)).filter((a) => !a.data.avance);
const [destacado] = articulos;

// Números reales del diario, calculados al compilar.
const minutos = articulos.reduce((total, a) => total + minutosDeLectura(a.body), 0);
const figuras = Object.keys(import.meta.glob("../figuras/*.astro")).length;
const numeros = [
  { valor: articulos.length, texto: articulos.length === 1 ? t.articulo : t.articulos },
  { valor: minutos, texto: t.minutos },
  { valor: figuras, texto: figuras === 1 ? t.figura : t.figuras },
];

const stack = ["Node.js", "TypeScript", "Express", "PostgreSQL", "Redis", "Kafka", "WebSockets", "Docker", "React", "Flutter"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.fullName,
  alternateName: AUTHOR.name,
  url: new URL(RUTAS[idioma].inicio, SITE.url).href,
  jobTitle: AUTHOR.role,
  knowsAbout: ["Node.js", "TypeScript", "Express", "PostgreSQL", "Redis", "Apache Kafka", "WebSockets", "Docker", "Git", "APIs REST", "Flutter"],
  sameAs: PERFILES,
};
---

<Base title={UI[idioma].sitio.titulo} jsonLd={jsonLd} alternate={RUTAS[otroIdioma(idioma)].inicio}>
  <section class="contenedor heroe">
    <div class="presentacion">
      <p class="rotulo"><span class="acento">$</span> whoami</p>
      <!-- Se escribe letra por letra, como en una máquina de escribir. El texto completo está en el HTML para
           lectores de pantalla y buscadores; las letras sueltas solo lo dibujan. -->
      <h1 class="maquina">
        <span class="solo-lectores">{t.saludo}</span>
        <span aria-hidden="true">{[...t.saludo].map((letra, i) => <span class="letra" style={`--i:${i}`}>{letra}</span>)}<span class="carro" style={`--n:${[...t.saludo].length}`} /></span>
      </h1>
      <p class="breve">{t.breve}</p>
      <details class="mas">
        <summary><span class="abrir">{t.verMas}</span><span class="cerrar">{t.verMenos}</span></summary>
        <p class="entrada" set:html={t.entrada} />
      </details>
      <div class="acciones">
        <a class="boton principal" href={RUTAS[idioma].diario}>{t.leer}</a>
        {AUTHOR.github && <a class="boton" href={AUTHOR.github} rel="me">GitHub</a>}
        {AUTHOR.linkedin && <a class="boton" href={AUTHOR.linkedin} rel="me">LinkedIn</a>}
      </div>
    </div>
    <HeroMono />
  </section>

  <section class="contenedor bento" aria-label={t.resumen}>
    {
      destacado && (
        <article class="celda destacado" data-brillo>
          {destacado.data.imagen ? (
            <Image
              class="portada"
              src={destacado.data.imagen}
              alt={destacado.data.imagenAlt ?? ""}
              widths={[480, 760, 1200]}
              sizes="(min-width: 860px) 540px, 100vw"
              loading="eager"
            />
          ) : (
            <img class="portada" src={`/og/${destacado.id}.png`} alt="" width="1200" height="630" loading="eager" />
          )}
          <div class="texto">
            <p class="rotulo">
              {t.ultimo} · <time datetime={fechaIso(destacado.data.fecha)}>{fechaLarga(destacado.data.fecha, idioma)}</time>
            </p>
            <h2>
              <a href={urlDe(destacado)}>{destacado.data.titulo}</a>
            </h2>
            <p>{destacado.data.descripcion}</p>
          </div>
        </article>
      )
    }

    <div class="celda ahora" data-brillo>
      <p class="rotulo">{t.ahora}</p>
      <ul>
        {t.ahoraLista.map((item) => <li set:html={item} />)}
      </ul>
    </div>

    <div class="celda numeros" data-brillo>
      <p class="rotulo">{t.numeros}</p>
      <dl>
        {
          numeros.map((n) => (
            <div>
              <dt>{n.texto}</dt>
              <dd>{n.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="celda quien" data-brillo>
      <p class="rotulo">{t.quien}</p>
      {t.bio.map((parrafo) => <p set:html={parrafo} />)}
      <ul class="stack" aria-label={t.tecnologias}>
        {stack.map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <div class="celda serie" data-brillo>
      <p class="rotulo"><a href={urlSerie("git-por-dentro", idioma)}>{t.rotuloSerie} · {t.serie}</a></p>
      <MapaSerie serie="git-por-dentro" idioma={idioma} compacta />
      <p class="ver-mapa"><a href={urlSerie("git-por-dentro", idioma)}>{UI[idioma].serie.abrirMapa} →</a></p>
    </div>
  </section>
</Base>

<script>
  // Brillo que sigue al cursor en las tarjetas (solo con ratón).
  for (const celda of document.querySelectorAll<HTMLElement>("[data-brillo]")) {
    celda.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      const r = celda.getBoundingClientRect();
      celda.style.setProperty("--x", `${e.clientX - r.left}px`);
      celda.style.setProperty("--y", `${e.clientY - r.top}px`);
    });
  }
</script>

<style>
  .heroe {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    align-items: center;
    gap: 8px;
    padding-top: clamp(16px, 4vw, 40px);
    padding-bottom: clamp(24px, 4vw, 40px);
  }
  .presentacion {
    position: relative;
    z-index: 1;
  }
  /* En pantallas angostas el mono baja debajo del texto */
  @media (max-width: 760px) {
    .heroe {
      grid-template-columns: 1fr;
      padding-top: clamp(32px, 9vw, 64px);
    }
  }
  .acento {
    color: var(--accent);
  }
  h1 {
    margin: 10px 0 18px;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    letter-spacing: -0.03em;
  }
  /* Hero con letra de máquina de escribir (solo aquí) */
  .maquina,
  .breve,
  .mas,
  .presentacion .boton {
    font-family: "Special Elite", "Courier New", monospace;
  }
  .maquina {
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.08;
  }
  .solo-lectores {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .letra {
    animation: tecla 0.01s steps(1, end) both;
    animation-delay: calc(var(--i) * 70ms + 250ms);
  }
  @keyframes tecla {
    from {
      opacity: 0;
    }
  }
  .carro {
    display: inline-block;
    width: 0.08em;
    height: 0.9em;
    margin-left: 0.06em;
    vertical-align: -0.08em;
    background: var(--brand);
    /* Invisible mientras se escribe; al terminar, parpadea */
    opacity: 0;
    animation: parpadeo-carro 1.1s steps(1, end) calc(var(--n) * 70ms + 250ms) infinite;
  }
  @keyframes parpadeo-carro {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  .breve {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
  }
  .mas {
    margin-top: 14px;
  }
  .mas summary {
    display: inline-block;
    color: var(--accent);
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 50%, transparent);
    text-underline-offset: 4px;
    cursor: pointer;
    list-style: none;
  }
  .mas summary::-webkit-details-marker {
    display: none;
  }
  .mas .cerrar,
  .mas[open] .abrir {
    display: none;
  }
  .mas[open] .cerrar {
    display: inline;
  }
  .mas .entrada {
    margin-top: 12px;
    font-size: 1.02rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .letra,
    .carro {
      animation: none;
    }
    .carro {
      opacity: 1;
    }
  }
  .entrada {
    max-width: 38ch;
    margin: 0;
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    line-height: 1.5;
  }
  .entrada strong {
    color: var(--strong);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .boton {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--strong);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: transform 0.2s var(--ease);
  }
  .boton:hover {
    transform: translateY(-1px);
    color: var(--strong);
  }
  .boton.principal {
    background: var(--strong);
    color: var(--page);
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }
  .celda {
    position: relative;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  /* resplandor radial que sigue al cursor */
  .celda::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(360px circle at var(--x, 50%) var(--y, 0%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .celda:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }
  .celda:hover::before {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .celda,
    .celda:hover {
      transform: none;
    }
  }
  .celda .rotulo {
    margin: 0 0 12px;
    font-size: 12px;
  }
  .celda p:not(.rotulo) {
    margin: 0 0 10px;
    font-size: 15.5px;
  }
  .celda strong {
    color: var(--strong);
  }
  .celda ul,
  .celda ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .destacado {
    grid-column: span 4;
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  .portada {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }
  .destacado .texto {
    padding: 20px 24px 24px;
  }
  .destacado h2 {
    margin: 0 0 8px;
    font-size: 1.5rem;
  }
  .destacado h2 a {
    text-decoration: none;
  }
  /* toda la tarjeta lleva al artículo */
  .destacado h2 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .ahora,
  .numeros {
    grid-column: span 2;
  }
  .ahora li {
    position: relative;
    padding-left: 16px;
    margin-bottom: 8px;
    font-size: 15px;
    line-height: 1.5;
  }
  .ahora li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .numeros dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .numeros dl div {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: baseline;
    gap: 10px;
  }
  .numeros dd {
    margin: 0;
    min-width: 2ch;
    color: var(--strong);
    font: 700 2rem/1 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .numeros dt {
    font-size: 14.5px;
  }

  .quien,
  .serie {
    grid-column: span 3;
  }
  .ver-mapa {
    margin: 14px 0 0 !important;
    font-size: 14.5px;
    font-weight: 600;
  }
  .celda .rotulo a {
    color: inherit;
    text-decoration: none;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px !important;
  }
  .stack li {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    font: 500 12.5px/1.6 var(--font-mono);
    color: var(--strong);
  }

  @media (max-width: 860px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .destacado,
    .quien,
    .serie {
      grid-column: span 2;
      grid-row: auto;
    }
    .ahora,
    .numeros {
      grid-column: span 1;
    }
  }
  @media (max-width: 560px) {
    .ahora,
    .numeros {
      grid-column: span 2;
    }
  }
</style>
