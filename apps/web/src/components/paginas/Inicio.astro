---
import "@fontsource/special-elite/latin-400.css";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import HeroMono from "../HeroMono.astro";
import MapaSerie from "../MapaSerie.astro";
import { AUTHOR, PERFILES, SITE } from "../../config";
import { idiomaDe, otroIdioma, RUTAS, UI } from "../../i18n";
import { fechaIso, fechaLarga, getArticulos, urlDe } from "../../lib/diario";
import { portadaBanner } from "../../lib/portadas.mjs";
import { urlSerie } from "../../series";

const idioma = idiomaDe(Astro.currentLocale);
const t = UI[idioma].inicio;
const ta = UI[idioma].articulo;
// Un avance (solo el comienzo) no cuenta como publicado; los subartículos (rama) son lectura opcional
// desde su artículo padre y no compiten con el camino principal en la portada.
const publicados = (await getArticulos(idioma)).filter((a) => !a.data.avance);
const principales = publicados.filter((a) => !a.data.rama);
const subarticulos = publicados.filter((a) => !!a.data.rama);
const [destacado] = principales.length ? principales : publicados;
const portadaDestacado = destacado && !destacado.data.imagen ? portadaBanner(destacado.id) : null;

// Números reales del diario, calculados al compilar (se muestran como línea sutil, no como tarjeta aislada).
const figuras = Object.keys(import.meta.glob("../figuras/*.astro")).length;
const partesResumen = [
  `${principales.length} ${principales.length === 1 ? t.articulo : t.articulos}`,
  ...(subarticulos.length > 0 ? [`${subarticulos.length} ${subarticulos.length === 1 ? ta.profundizarUno : ta.profundizarVarios}`] : []),
  `${figuras} ${figuras === 1 ? t.figura : t.figuras}`,
];
const resumenDiario = partesResumen.join(" · ");

const stack = ["Node.js", "TypeScript", "Express", "PostgreSQL", "Redis", "Kafka", "WebSockets", "Docker", "React", "Flutter"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.fullName,
  alternateName: AUTHOR.name,
  url: new URL(RUTAS[idioma].inicio, SITE.url).href,
  jobTitle: AUTHOR.role,
  knowsAbout: ["Node.js", "TypeScript", "Express", "PostgreSQL", "Redis", "Apache Kafka", "WebSockets", "Docker", "Git", "APIs REST", "Flutter"],
  sameAs: PERFILES,
};
---

<Base title={UI[idioma].sitio.titulo} jsonLd={jsonLd} alternate={RUTAS[otroIdioma(idioma)].inicio}>
  <section class="contenedor heroe">
    <div class="presentacion">
      <p class="rotulo comando"><span class="acento">$</span> whoami</p>
      <!-- Se escribe letra por letra, como en una máquina de escribir. El texto completo está en el HTML para
           lectores de pantalla y buscadores; las letras sueltas solo lo dibujan. -->
      <h1 class="maquina">
        <span class="solo-lectores">{t.saludo}</span>
        <span aria-hidden="true">{[...t.saludo].map((letra, i) => <span class="letra" style={`--i:${i}`}>{letra}</span>)}<span class="carro" style={`--n:${[...t.saludo].length}`} /></span>
      </h1>
      <p class="breve">{t.breve}</p>
      <details class="mas">
        <summary><span class="abrir">{t.verMas}</span><span class="cerrar">{t.verMenos}</span></summary>
        <p class="entrada" set:html={t.entrada} />
      </details>
      <div class="acciones">
        <a class="boton principal" href={RUTAS[idioma].diario}>
          <span>{t.leer}</span>
          <span class="flecha" aria-hidden="true">→</span>
        </a>
        {
          AUTHOR.github && (
            <a class="boton secundario" href={AUTHOR.github} rel="me">
              <span>GitHub</span>
              <span class="externo" aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          AUTHOR.linkedin && (
            <a class="boton secundario" href={AUTHOR.linkedin} rel="me">
              <span>LinkedIn</span>
              <span class="externo" aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
    <HeroMono />
  </section>

  <section class="contenedor lectura" aria-label={t.resumen}>
    {
      destacado && (
        <article class="celda destacado" data-brillo>
          {destacado.data.imagen ? (
            <Image
              class="portada"
              src={destacado.data.imagen}
              alt={destacado.data.imagenAlt ?? ""}
              widths={[480, 760, 1200]}
              sizes="(min-width: 860px) 540px, 100vw"
              loading="eager"
            />
          ) : portadaDestacado ? (
            <div class="portada portada-escena" aria-hidden="true" set:html={portadaDestacado} />
          ) : (
            <img class="portada" src={`/og/${destacado.id}.png`} alt="" width="1200" height="630" loading="eager" />
          )}
          <div class="texto">
            <p class="rotulo">
              {t.ultimo} · <time datetime={fechaIso(destacado.data.fecha)}>{fechaLarga(destacado.data.fecha, idioma)}</time>
            </p>
            <h2>
              <a href={urlDe(destacado)}>{destacado.data.titulo}</a>
            </h2>
            <p>{destacado.data.descripcion}</p>
          </div>
        </article>
      )
    }

    <div class="celda serie" data-brillo>
      <p class="rotulo"><a href={urlSerie("git-por-dentro", idioma)}>{t.rotuloSerie} · {t.serie}</a></p>
      <MapaSerie serie="git-por-dentro" idioma={idioma} compacta soloActivas />
      <p class="resumen-diario">{resumenDiario}</p>
      <p class="ver-mapa"><a href={urlSerie("git-por-dentro", idioma)}>{UI[idioma].serie.abrirMapa} →</a></p>
    </div>
  </section>

  <section class="contenedor sobre-mi" aria-label={t.quien}>
    <div class="bio-bloque">
      <p class="rotulo">{t.quien}</p>
      {t.bio.map((parrafo) => <p set:html={parrafo} />)}
      <ul class="stack" aria-label={t.tecnologias}>
        {stack.map((tech) => <li>{tech}</li>)}
      </ul>
    </div>

    <div class="celda ahora" data-brillo>
      <p class="rotulo">{t.ahora}</p>
      <ul>
        {t.ahoraLista.map((item) => <li set:html={item} />)}
      </ul>
    </div>
  </section>
</Base>

<script>
  // Brillo que sigue al cursor en las tarjetas (solo con ratón).
  for (const celda of document.querySelectorAll<HTMLElement>("[data-brillo]")) {
    celda.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      const r = celda.getBoundingClientRect();
      celda.style.setProperty("--x", `${e.clientX - r.left}px`);
      celda.style.setProperty("--y", `${e.clientY - r.top}px`);
    });
  }
</script>

<style>
  .heroe {
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 3vw, 32px);
    padding-block-start: clamp(18px, 3.5vw, 38px);
    padding-block-end: clamp(28px, 4.5vw, 48px);
  }
  .presentacion {
    position: relative;
    z-index: 1;
    min-inline-size: 0;
  }
  /* En pantallas angostas el mono baja debajo del texto */
  @media (max-width: 760px) {
    .heroe {
      grid-template-columns: 1fr;
      gap: 12px;
      padding-block-start: clamp(24px, 7vw, 48px);
      padding-block-end: clamp(24px, 6vw, 36px);
    }
  }
  .comando {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }
  .acento {
    color: var(--accent);
    font-weight: 700;
  }
  h1 {
    margin: 12px 0 16px;
    max-inline-size: 13ch;
    font-size: clamp(2.25rem, 5.2vw, 3.35rem);
    letter-spacing: -0.02em;
  }
  /* Special Elite se reserva solo para el titular: así destaca y el resto respira con el sistema del sitio */
  .maquina {
    font-family: "Special Elite", "Courier New", monospace;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.08;
    text-wrap: normal;
  }
  .solo-lectores {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .carro {
    display: inline-block;
    inline-size: 0.1em;
    block-size: 0.86em;
    margin-inline-start: 0.08em;
    border-radius: 2px;
    vertical-align: -0.07em;
    background: var(--accent);
    opacity: 1;
  }
  .breve {
    margin: 0;
    font: 500 clamp(0.88rem, 1.5vw, 0.96rem) / 1.5 var(--font-mono);
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .mas {
    margin-block-start: 14px;
  }
  .mas summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 0;
    color: var(--accent);
    font: 600 0.92rem / 1.2 var(--font-sans);
    cursor: pointer;
    list-style: none;
    transition: color 0.2s var(--ease);
  }
  .mas summary:hover {
    color: var(--strong);
  }
  .mas summary::-webkit-details-marker {
    display: none;
  }
  /* Indicador rotatorio pegado al texto del summary (sigue el color actual y rota al abrir) */
  .mas summary::before {
    content: "";
    inline-size: 6px;
    block-size: 6px;
    flex-shrink: 0;
    border-inline-end: 1.75px solid currentColor;
    border-block-end: 1.75px solid currentColor;
    rotate: -45deg;
    translate: -1px 0;
  }
  .mas[open] > summary::before {
    rotate: 45deg;
    translate: 0 -1px;
  }
  .mas .cerrar,
  .mas[open] .abrir {
    display: none;
  }
  .mas[open] .cerrar {
    display: inline;
  }
  .mas::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }
  .mas:not([open])::details-content {
    block-size: 0;
  }
  .mas .entrada {
    margin-block: 12px 2px;
    padding-inline-start: 14px;
    border-inline-start: 2px solid var(--brand);
    font-size: 0.98rem;
    line-height: 1.62;
    color: var(--text);
  }
  .entrada {
    max-inline-size: 40ch;
    margin: 0;
  }
  .entrada strong {
    color: var(--strong);
    font-weight: 600;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-block-start: 28px;
  }
  .boton {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-block-size: 44px;
    padding-inline: 18px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--surface);
    color: var(--strong);
    font: 600 14.5px / 1 var(--font-sans);
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      color 0.2s var(--ease),
      box-shadow 0.2s var(--ease),
      translate 0.2s var(--ease),
      scale 0.15s var(--ease);
  }
  .boton:hover {
    translate: 0 -1px;
    color: var(--strong);
  }
  .boton:active {
    translate: 0 0;
    scale: 0.98;
  }
  .boton.principal {
    padding-inline: 22px;
    background: var(--strong);
    color: var(--page);
    box-shadow: var(--shadow);
  }
  .boton.principal:hover {
    color: var(--page);
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--brand) 65%, transparent),
      0 10px 22px -12px color-mix(in srgb, var(--strong) 45%, transparent);
  }
  .boton.secundario {
    padding-inline: 15px;
    border-color: var(--line);
    background: color-mix(in srgb, var(--surface) 75%, transparent);
    color: var(--text);
    font-weight: 500;
  }
  .boton.secundario:hover {
    border-color: var(--line-strong);
    background: var(--surface);
    color: var(--strong);
  }
  .flecha,
  .externo {
    display: inline-block;
    transition: translate 0.2s var(--ease), color 0.2s var(--ease);
  }
  .externo {
    font-size: 0.85em;
    color: var(--muted);
  }
  .boton.principal:hover .flecha {
    translate: 3px 0;
  }
  .boton.secundario:hover .externo {
    translate: 1px -1px;
    color: var(--accent);
  }
  /* Opt-in de animaciones: sin reducir movimiento se escribe letra por letra y el despliegue desliza */
  @media (prefers-reduced-motion: no-preference) {
    .letra {
      animation: tecla 45ms linear both;
      animation-delay: calc(var(--i) * 38ms + 120ms);
    }
    .carro {
      opacity: 0;
      animation: parpadeo-carro 1.05s steps(1, end) calc(var(--n) * 38ms + 140ms) infinite;
    }
    .comando,
    .breve,
    .mas,
    .acciones {
      animation: entrar-heroe 0.45s var(--ease) both;
    }
    .comando {
      animation-delay: 40ms;
    }
    .breve {
      animation-delay: 240ms;
    }
    .mas {
      animation-delay: 320ms;
    }
    .acciones {
      animation-delay: 400ms;
    }
    .mas summary::before {
      transition: rotate 0.2s var(--ease), translate 0.2s var(--ease);
    }
    .mas::details-content {
      transition: block-size, content-visibility, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease);
      transition-behavior: allow-discrete;
    }
  }
  @keyframes tecla {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes parpadeo-carro {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
  @keyframes entrar-heroe {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }

  /* Bloque 1: Lectura (último artículo + serie activa) */
  .lectura {
    display: grid;
    grid-template-columns: minmax(0, 1.32fr) minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }
  .celda {
    position: relative;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
    transition: translate 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  /* resplandor radial que sigue al cursor */
  .celda::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(360px circle at var(--x, 50%) var(--y, 0%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .celda:hover {
    translate: 0 -2px;
    border-color: var(--line-strong);
  }
  .celda:hover::before {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .celda,
    .celda:hover {
      translate: none;
    }
  }
  .celda .rotulo {
    margin: 0 0 12px;
    font-size: 12px;
  }
  .celda p:not(.rotulo) {
    margin: 0 0 10px;
    font-size: 15.5px;
  }
  .celda strong {
    color: var(--strong);
  }
  .celda ul,
  .celda ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .destacado {
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  .portada {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }
  .portada-escena {
    display: grid;
    place-items: center;
    padding: 8px;
    background: var(--page);
  }
  .portada-escena :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }
  .destacado .texto {
    padding: 20px 24px 24px;
  }
  .destacado h2 {
    margin: 0 0 8px;
    font-size: 1.45rem;
  }
  .destacado h2 a {
    text-decoration: none;
  }
  /* toda la tarjeta lleva al artículo */
  .destacado h2 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .serie {
    display: flex;
    flex-direction: column;
  }
  .resumen-diario {
    margin: auto 0 0 !important;
    padding-block-start: 16px;
    font: 500 12.5px / 1.5 var(--font-mono) !important;
    color: var(--muted);
  }
  .ver-mapa {
    margin: 8px 0 0 !important;
    font-size: 14.5px;
    font-weight: 600;
  }
  .celda .rotulo a {
    color: inherit;
    text-decoration: none;
  }

  /* Bloque 2: Sobre mí (separado visualmente de la lectura para no mezclar intenciones) */
  .sobre-mi {
    display: grid;
    grid-template-columns: minmax(0, 1.32fr) minmax(0, 1fr);
    gap: 24px 32px;
    align-items: start;
    margin-block-start: 48px;
    padding-block-start: 36px;
    border-top: 1px solid var(--line);
  }
  .bio-bloque .rotulo {
    margin: 0 0 12px;
  }
  .bio-bloque p:not(.rotulo) {
    margin: 0 0 12px;
    font-size: 15.5px;
    line-height: 1.65;
  }
  .bio-bloque strong {
    color: var(--strong);
  }
  .ahora li {
    position: relative;
    padding-inline-start: 16px;
    margin-block-end: 10px;
    font-size: 15px;
    line-height: 1.55;
  }
  .ahora li:last-child {
    margin-block-end: 0;
  }
  .ahora li::before {
    content: "›";
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    flex-wrap: balance;
    gap: 6px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .stack li {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font: 500 12.5px / 1.6 var(--font-mono);
    color: var(--strong);
  }

  @media (max-width: 780px) {
    .lectura,
    .sobre-mi {
      grid-template-columns: 1fr;
    }
    .sobre-mi {
      margin-block-start: 36px;
      padding-block-start: 28px;
    }
  }
</style>
