---
import Base from "../../layouts/Base.astro";
import TarjetaArticulo from "../TarjetaArticulo.astro";
import { SITE } from "../../config";
import { idiomaDe, otroIdioma, RUTAS, UI } from "../../i18n";
import { getArticulos } from "../../lib/diario";

const idioma = idiomaDe(Astro.currentLocale);
const t = UI[idioma].diario;
const articulos = await getArticulos(idioma);
---

<Base title={`${UI[idioma].nav.diario} · ${SITE.name}`} description={t.descripcion} alternate={RUTAS[otroIdioma(idioma)].diario}>
  <section class="contenedor">
    <p class="rotulo">{UI[idioma].nav.diario}</p>
    <h1>{t.titulo}</h1>
    <p class="entrada">{t.entrada}</p>
    <div class="rejilla">
      {articulos.map((articulo) => <TarjetaArticulo articulo={articulo} />)}
    </div>
  </section>
</Base>

<style>
  section {
    padding-top: clamp(24px, 6vw, 64px);
  }
  h1 {
    margin: 8px 0 14px;
    font-size: clamp(2rem, 6vw, 3rem);
  }
  .entrada {
    max-width: 60ch;
    margin: 0 0 40px;
    font-size: 1.1rem;
  }
  .rejilla {
    display: grid;
    gap: 16px;
  }
</style>
