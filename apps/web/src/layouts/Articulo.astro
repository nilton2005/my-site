---
import { getImage } from "astro:assets";
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import Indice from "../components/Indice.astro";
import MapaSerie from "../components/MapaSerie.astro";
import Portada from "../components/Portada.astro";
import UbicacionSerie from "../components/UbicacionSerie.astro";
import { AUTHOR, PERFILES, SITE } from "../config";
import { RUTAS, UI } from "../i18n";
import { fechaIso, fechaLarga, getArticulos, minutosDeLectura, traduccionDe, urlDe, type Articulo } from "../lib/diario";
import { resolverSerie } from "../lib/serie";
import { serieDe, urlSerie } from "../series";

interface Props {
  articulo: Articulo;
  headings: MarkdownHeading[];
}

const { articulo, headings } = Astro.props;
const { titulo, descripcion, fecha, actualizado, serie, etiquetas, imagen, imagenAlt, idioma } = articulo.data;
const t = UI[idioma].articulo;
const ts = UI[idioma].serie;
const rutas = RUTAS[idioma];
const traduccion = await traduccionDe(articulo);
const todos = await getArticulos(idioma);
const padre = articulo.data.rama ? todos.find((a) => a.id === articulo.data.rama) : undefined;
const ramas = todos.filter((a) => a.data.rama === articulo.id);
// Una rama no declara serie: hereda la de su artículo padre, para mostrar dónde cae en la línea de tiempo.
const claveSerie = serieDe((serie ?? padre?.data.serie)?.nombre)?.[0];
const partesSerie = claveSerie ? await resolverSerie(claveSerie, idioma) : [];
const disponiblesSerie = partesSerie.filter((p) => p.estado !== "proximamente").length;
const minutos = minutosDeLectura(articulo.body);
const url = new URL(urlDe(articulo), Astro.site).href;

// Imagen para redes: JPG 1200 px con URL absoluta (LinkedIn y X no siempre aceptan WebP).
// Sin imagen propia, se usa la generada en /og/<slug>.png (pages/og/[slug].png.ts).
const og = imagen
  ? new URL((await getImage({ src: imagen, width: 1200, format: "jpg" })).src, Astro.site).href
  : new URL(`/og/${articulo.id}.png`, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: titulo,
  description: descripcion,
  datePublished: fecha.toISOString(),
  dateModified: (actualizado ?? fecha).toISOString(),
  inLanguage: idioma,
  mainEntityOfPage: url,
  url,
  image: og,
  keywords: etiquetas.join(", "),
  author: { "@type": "Person", name: AUTHOR.fullName, alternateName: AUTHOR.name, url: SITE.url, sameAs: PERFILES },
  ...(serie && { isPartOf: { "@type": "CreativeWorkSeries", name: serie.nombre } }),
};
---

<Base
  title={`${titulo} · ${SITE.name}`}
  description={descripcion}
  image={og}
  imageAlt={imagenAlt}
  type="article"
  publishedTime={fecha}
  modifiedTime={actualizado}
  jsonLd={jsonLd}
  alternate={traduccion && urlDe(traduccion)}
>
  <div class="progreso" aria-hidden="true"><span data-progreso></span></div>
  <article class="articulo" data-pagefind-body>
    <header class="encabezado">
      {
        claveSerie ? (
          <UbicacionSerie serie={claveSerie} idioma={idioma} actual={articulo.id} modo="cabecera" />
        ) : (
          <p class="rotulo">
            <a href={rutas.diario}>{UI[idioma].nav.diario}</a>
          </p>
        )
      }
      <h1>{titulo}</h1>
      <p class="entrada">{descripcion}</p>
      {articulo.data.avance && <p class="aviso-avance" role="note">{t.avance}</p>}
      <p class="meta">
        <time datetime={fechaIso(fecha)}>{fechaLarga(fecha, idioma)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutos} {t.lectura}</span>
        {actualizado && (
          <>
            <span aria-hidden="true">·</span>
            <span>{t.actualizado} <time datetime={fechaIso(actualizado)}>{fechaLarga(actualizado, idioma)}</time></span>
          </>
        )}
      </p>
    </header>
    <Portada id={articulo.id} />
    <Indice headings={headings} />
    <div class="prosa">
      <slot />
    </div>
    {claveSerie && <UbicacionSerie serie={claveSerie} idioma={idioma} actual={articulo.id} modo="pie" />}
    {
      ramas.length > 0 && (
        <aside class="ramas">
          <p class="rotulo">{t.ramas}</p>
          <ul>
            {ramas.map((r) => (
              <li>
                <a href={urlDe(r)}>
                  {r.data.titulo}
                  {r.data.avance && <em class="avance-rama"> · {ts.avance}</em>}
                </a>
                <span>{r.data.descripcion}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
    {
      claveSerie && (
        <details class="mapa-desplegable" data-pagefind-ignore>
          <summary>
            <span class="mapa-titulo">
              {ts.mapa} · {(serie ?? padre!.data.serie)!.nombre}
            </span>
            <span class="mapa-cuenta">
              {disponiblesSerie} {ts.de} {partesSerie.length} {ts.disponibles}
            </span>
          </summary>
          <div class="mapa-cuerpo">
            <MapaSerie serie={claveSerie} idioma={idioma} actual={articulo.id} leyenda />
            <p class="mapa-ver">
              <a href={urlSerie(claveSerie, idioma)}>{ts.abrirMapa} →</a>
            </p>
          </div>
        </details>
      )
    }
    <footer class="cierre" data-pagefind-ignore>
      {etiquetas.length > 0 && (
        <ul class="etiquetas" aria-label={t.etiquetas}>
          {etiquetas.map((etiqueta) => <li>{etiqueta}</li>)}
        </ul>
      )}
      <p>
        {t.cierre}{" "}
        {t.siTeSirvio}{" "}
        {AUTHOR.linkedin && <><a href={AUTHOR.linkedin}>{t.sigueme}</a> {t.o} </>}
        {t.suscribete} <a href={rutas.rss}>RSS</a>.
      </p>
      <div class="cierre-acciones">
        <a href={rutas.diario}>{t.volver}</a>
        <button class="copiar-enlace" type="button" data-copiar-url={url} data-texto={t.compartir} data-ok={t.compartido}>{t.compartir}</button>
      </div>
    </footer>
  </article>
</Base>

<script>
  // Barra de progreso de lectura: avanza con el scroll dentro del artículo.
  const barra = document.querySelector<HTMLElement>("[data-progreso]");
  const articulo = document.querySelector<HTMLElement>(".articulo");
  if (barra && articulo) {
    let pendiente = false;
    const medir = () => {
      pendiente = false;
      const { top, height } = articulo.getBoundingClientRect();
      const total = height - innerHeight;
      const avance = total > 0 ? Math.min(1, Math.max(0, -top / total)) : 1;
      barra.style.transform = `scaleX(${avance.toFixed(4)})`;
    };
    addEventListener("scroll", () => { if (!pendiente) { pendiente = true; requestAnimationFrame(medir); } }, { passive: true });
    addEventListener("resize", medir);
    medir();
  }

  // Botón de copiar enlace del artículo para compartirlo rápido.
  const copiarUrl = document.querySelector<HTMLButtonElement>("[data-copiar-url]");
  let timerCopiar: number | undefined;
  copiarUrl?.addEventListener("click", async () => {
    const destino = copiarUrl.dataset.copiarUrl;
    if (!destino) return;
    try {
      await navigator.clipboard.writeText(destino);
      copiarUrl.textContent = copiarUrl.dataset.ok ?? "";
      copiarUrl.dataset.copiado = "";
      clearTimeout(timerCopiar);
      timerCopiar = window.setTimeout(() => {
        copiarUrl.textContent = copiarUrl.dataset.texto ?? "";
        delete copiarUrl.dataset.copiado;
      }, 1600);
    } catch {}
  });
</script>

<style>
  .progreso {
    position: fixed;
    inset: 0 0 auto;
    height: 3px;
    z-index: 20;
    pointer-events: none;
  }
  .progreso span {
    display: block;
    height: 100%;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .articulo {
    width: min(calc(var(--measure) + 2 * var(--gutter)), 100%);
    margin: 0 auto;
    padding: 24px var(--gutter) 0;
  }
  .encabezado {
    margin-block-end: 24px;
  }
  .encabezado .rotulo a {
    color: inherit;
  }
  h1 {
    margin: 12px 0 14px;
    font-size: clamp(2rem, 6vw, 3rem);
  }
  .entrada {
    margin: 0 0 18px;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--text);
  }
  .aviso-avance {
    display: inline-block;
    margin: 0 0 14px;
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font: 600 12px/1.8 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .prosa :global(h2) {
    margin: 2.2em 0 0.6em;
    font-size: 1.6rem;
  }
  .prosa :global(h3) {
    margin: 1.8em 0 0.5em;
    font-size: 1.25rem;
  }
  .prosa :global(p),
  .prosa :global(li) {
    text-wrap: pretty;
  }
  .prosa :global(strong) {
    color: var(--strong);
  }
  .prosa :global(:not(pre) > code) {
    padding: 0.12em 0.36em;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--code-bg);
    color: var(--strong);
    overflow-wrap: anywhere;
  }
  .prosa :global(blockquote) {
    margin: 1.8em 0;
    padding: 4px 0 4px 20px;
    border-left: 3px solid var(--accent);
    color: var(--strong);
  }
  .prosa :global(blockquote p) {
    margin: 0.4em 0;
  }
  .prosa :global(table) {
    width: 100%;
    margin: 1.6em 0;
    border-collapse: collapse;
    font-size: 15.5px;
  }
  .prosa :global(th),
  .prosa :global(td) {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prosa :global(th) {
    color: var(--strong);
    font-weight: 600;
  }
  .prosa :global(.tabla) {
    overflow-x: auto;
  }

  .ramas {
    margin-block-start: 24px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-inline-start: 3px dashed var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .ramas .rotulo {
    margin: 0 0 8px;
    color: var(--accent);
  }
  .ramas ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ramas li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
  }
  .ramas li a {
    font-weight: 600;
  }
  .ramas .avance-rama {
    color: var(--muted);
    font: 500 12px / 1 var(--font-mono);
    font-style: normal;
    text-transform: uppercase;
  }
  .ramas li span {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.5;
  }

  .mapa-desplegable {
    margin-block-start: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .mapa-desplegable summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    padding: 14px 20px;
    cursor: pointer;
    list-style: none;
    color: var(--strong);
  }
  .mapa-desplegable summary::-webkit-details-marker {
    display: none;
  }
  .mapa-desplegable summary::before {
    content: "";
    inline-size: 6px;
    block-size: 6px;
    flex-shrink: 0;
    border-inline-end: 1.75px solid var(--accent);
    border-block-end: 1.75px solid var(--accent);
    rotate: -45deg;
  }
  .mapa-desplegable[open] > summary::before {
    rotate: 45deg;
  }
  .mapa-titulo {
    font: 600 12.5px / 1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .mapa-cuenta {
    margin-inline-start: auto;
    padding: 2px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font: 500 11.5px / 1.6 var(--font-mono);
    color: var(--muted);
  }
  .mapa-desplegable::details-content {
    interpolate-size: allow-keywords;
    overflow: clip;
    contain: layout;
  }
  .mapa-desplegable:not([open])::details-content {
    block-size: 0;
  }
  .mapa-cuerpo {
    padding: 4px 20px 20px;
    border-top: 1px solid var(--line);
  }
  .mapa-ver {
    margin: 18px 0 0;
    font-size: 14.5px;
    font-weight: 600;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mapa-desplegable summary::before {
      transition: rotate 0.2s var(--ease);
    }
    .mapa-desplegable::details-content {
      transition: block-size, content-visibility, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease);
      transition-behavior: allow-discrete;
    }
  }

  .cierre {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 15.5px;
  }
  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }
  .etiquetas li {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font: 500 13px/1.8 var(--font-mono);
  }
  .cierre-acciones {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-block-start: 16px;
  }
  .copiar-enlace {
    min-block-size: 36px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--strong);
    font: 500 13.5px / 1 var(--font-sans);
    cursor: pointer;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .copiar-enlace:hover {
    border-color: var(--line-strong);
    color: var(--accent);
  }
  .copiar-enlace[data-copiado] {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
