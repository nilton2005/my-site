---
import { getImage } from "astro:assets";
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import Indice from "../components/Indice.astro";
import { AUTHOR, PERFILES, SITE } from "../config";
import { fechaIso, fechaLarga, minutosDeLectura, urlDe, type Articulo } from "../lib/diario";

interface Props {
  articulo: Articulo;
  headings: MarkdownHeading[];
}

const { articulo, headings } = Astro.props;
const { titulo, descripcion, fecha, actualizado, serie, etiquetas, imagen, imagenAlt } = articulo.data;
const minutos = minutosDeLectura(articulo.body);
const url = new URL(urlDe(articulo), Astro.site).href;

// Imagen para redes: JPG 1200 px con URL absoluta (LinkedIn y X no siempre aceptan WebP).
// Sin imagen propia, se usa la generada en /og/<slug>.png (pages/og/[slug].png.ts).
const og = imagen
  ? new URL((await getImage({ src: imagen, width: 1200, format: "jpg" })).src, Astro.site).href
  : new URL(`/og/${articulo.id}.png`, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: titulo,
  description: descripcion,
  datePublished: fecha.toISOString(),
  dateModified: (actualizado ?? fecha).toISOString(),
  inLanguage: SITE.lang,
  mainEntityOfPage: url,
  url,
  image: og,
  keywords: etiquetas.join(", "),
  author: { "@type": "Person", name: AUTHOR.fullName, alternateName: AUTHOR.name, url: SITE.url, sameAs: PERFILES },
  ...(serie && { isPartOf: { "@type": "CreativeWorkSeries", name: serie.nombre } }),
};
---

<Base
  title={`${titulo} · ${SITE.name}`}
  description={descripcion}
  image={og}
  imageAlt={imagenAlt}
  type="article"
  publishedTime={fecha}
  modifiedTime={actualizado}
  jsonLd={jsonLd}
>
  <div class="progreso" aria-hidden="true"><span data-progreso></span></div>
  <article class="articulo" data-pagefind-body>
    <header class="encabezado">
      <p class="rotulo">
        <a href="/diario/">Diario</a>
        {serie && <span> / {serie.nombre} · {String(serie.orden).padStart(2, "0")}</span>}
      </p>
      <h1>{titulo}</h1>
      <p class="entrada">{descripcion}</p>
      <p class="meta">
        <time datetime={fechaIso(fecha)}>{fechaLarga(fecha)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutos} min de lectura</span>
        {actualizado && (
          <>
            <span aria-hidden="true">·</span>
            <span>actualizado el <time datetime={fechaIso(actualizado)}>{fechaLarga(actualizado)}</time></span>
          </>
        )}
      </p>
    </header>
    <Indice headings={headings} />
    <div class="prosa">
      <slot />
    </div>
    <footer class="cierre" data-pagefind-ignore>
      {etiquetas.length > 0 && (
        <ul class="etiquetas" aria-label="Etiquetas">
          {etiquetas.map((etiqueta) => <li>{etiqueta}</li>)}
        </ul>
      )}
      <p>
        Escribo sobre cómo funcionan por dentro las herramientas de backend.
        {AUTHOR.linkedin ? <>Si te sirvió, <a href={AUTHOR.linkedin}>sígueme en LinkedIn</a> o </> : <>Si te sirvió, </>}
        suscríbete por <a href="/rss.xml">RSS</a>.
      </p>
      <p><a href="/diario/">← Volver al diario</a></p>
    </footer>
  </article>
</Base>

<script>
  // Barra de progreso de lectura: avanza con el scroll dentro del artículo.
  const barra = document.querySelector<HTMLElement>("[data-progreso]");
  const articulo = document.querySelector<HTMLElement>(".articulo");
  if (barra && articulo) {
    let pendiente = false;
    const medir = () => {
      pendiente = false;
      const { top, height } = articulo.getBoundingClientRect();
      const total = height - innerHeight;
      const avance = total > 0 ? Math.min(1, Math.max(0, -top / total)) : 1;
      barra.style.transform = `scaleX(${avance.toFixed(4)})`;
    };
    addEventListener("scroll", () => { if (!pendiente) { pendiente = true; requestAnimationFrame(medir); } }, { passive: true });
    addEventListener("resize", medir);
    medir();
  }
</script>

<style>
  .progreso {
    position: fixed;
    inset: 0 0 auto;
    height: 3px;
    z-index: 20;
    pointer-events: none;
  }
  .progreso span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .articulo {
    width: min(calc(var(--measure) + 2 * var(--gutter)), 100%);
    margin: 0 auto;
    padding: 24px var(--gutter) 0;
  }
  .encabezado {
    margin-bottom: 40px;
  }
  .encabezado .rotulo a {
    color: inherit;
  }
  h1 {
    margin: 12px 0 14px;
    font-size: clamp(2rem, 6vw, 3rem);
  }
  .entrada {
    margin: 0 0 18px;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--text);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .prosa :global(h2) {
    margin: 2.2em 0 0.6em;
    font-size: 1.6rem;
  }
  .prosa :global(h3) {
    margin: 1.8em 0 0.5em;
    font-size: 1.25rem;
  }
  .prosa :global(p),
  .prosa :global(li) {
    text-wrap: pretty;
  }
  .prosa :global(strong) {
    color: var(--strong);
  }
  .prosa :global(:not(pre) > code) {
    padding: 0.12em 0.36em;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--code-bg);
    color: var(--strong);
    white-space: nowrap;
  }
  .prosa :global(table) {
    width: 100%;
    margin: 1.6em 0;
    border-collapse: collapse;
    font-size: 15.5px;
  }
  .prosa :global(th),
  .prosa :global(td) {
    padding: 8px 10px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prosa :global(th) {
    color: var(--strong);
    font-weight: 600;
  }
  .prosa :global(.tabla) {
    overflow-x: auto;
  }

  .cierre {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 15.5px;
  }
  .etiquetas {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }
  .etiquetas li {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font: 500 13px/1.8 var(--font-mono);
  }
</style>
