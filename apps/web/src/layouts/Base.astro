---
import "@niltontaco/tokens/tokens.css";
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Paleta from "../components/Paleta.astro";
import { idiomaDe, RUTAS, UI } from "../i18n";

interface Props {
  title: string;
  description?: string;
  /** URL absoluta de la imagen para redes. Por defecto, la del idioma. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Ruta de esta misma página en el otro idioma: la usan el switch y los hreflang. */
  alternate?: string | undefined;
}

const idioma = idiomaDe(Astro.currentLocale);
const t = UI[idioma];
const { description = t.sitio.descripcion, image = new URL(RUTAS[idioma].og, Astro.site).href, alternate, ...rest } = Astro.props;
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f3e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <Seo description={description} image={image} alternate={alternate} {...rest} />
    <script is:inline>
      // Antes de pintar: tema guardado o, si no hay, el del sistema. Así no hay parpadeo.
      (() => {
        let tema = null;
        try { tema = localStorage.getItem("tema"); } catch {}
        if (tema !== "light" && tema !== "dark") tema = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = tema;
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.nav.saltar}</a>
    <Header alternate={alternate} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <Paleta />
    <script>
      // Las figuras (.iso[data-figura]) siguen el tema del sitio; el botón alterna y lo recuerda.
      const raiz = document.documentElement;
      const aplicar = () => {
        for (const figura of document.querySelectorAll<HTMLElement>(".iso[data-figura]")) figura.dataset.theme = raiz.dataset.theme ?? "light";
      };
      aplicar();
      document.querySelector("[data-cambiar-tema]")?.addEventListener("click", () => {
        raiz.dataset.theme = raiz.dataset.theme === "dark" ? "light" : "dark";
        try { localStorage.setItem("tema", raiz.dataset.theme); } catch {}
        aplicar();
      });

      // Los marcos de código se generan en español (lib/codigo.mjs); en inglés se traducen aquí.
      const ingles = raiz.lang === "en";
      const textos = ingles ? { copiar: "Copy", copiado: "Copied", error: "Could not copy" } : { copiar: "Copiar", copiado: "Copiado", error: "No se pudo copiar" };
      if (ingles) {
        for (const boton of document.querySelectorAll<HTMLButtonElement>("[data-copiar]")) {
          boton.textContent = textos.copiar;
          boton.setAttribute("aria-label", "Copy the code");
        }
        for (const titulo of document.querySelectorAll(".codigo-titulo:not(.es-archivo)")) if (titulo.textContent === "texto") titulo.textContent = "text";
      }

      // Botón «Copiar» de los bloques de código. En la terminal copia solo los comandos (sin «$» ni la salida).
      document.addEventListener("click", async (e) => {
        const boton = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-copiar]");
        if (!boton) return;
        const marco = boton.closest(".codigo");
        const lineas = [...(marco?.querySelectorAll<HTMLElement>(".line") ?? [])].map((l) => l.textContent ?? "");
        const comandos = lineas.filter((l) => l.startsWith("$ ")).map((l) => l.slice(2));
        const texto = marco?.hasAttribute("data-terminal") && comandos.length ? comandos.join("\n") : lineas.join("\n");
        try {
          await navigator.clipboard.writeText(texto);
          boton.textContent = textos.copiado;
          boton.dataset.copiado = "";
        } catch {
          boton.textContent = textos.error;
        }
        setTimeout(() => {
          boton.textContent = textos.copiar;
          delete boton.dataset.copiado;
        }, 1600);
      });
    </script>
  </body>
</html>
