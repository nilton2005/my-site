---
import Base from "../layouts/Base.astro";
---

<Base title="Página no encontrada · Nilton Taco" description="Esta página no existe.">
  <section class="contenedor">
    <p class="rotulo">error 404</p>
    <h1>fatal: not a valid object name</h1>
    <p>Esa página no existe (o todavía no la escribo). Prueba con el <a href="/diario/">diario</a> o vuelve al <a href="/">inicio</a>.</p>
  </section>
</Base>

<style>
  section {
    padding-top: clamp(40px, 10vw, 120px);
  }
  h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 4.5vw, 2.2rem);
  }
</style>
