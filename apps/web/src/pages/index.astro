---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { AUTHOR, PERFILES, SITE } from "../config";
import { fechaIso, fechaLarga, getArticulos, minutosDeLectura, urlDe } from "../lib/diario";

const articulos = await getArticulos();
const [destacado] = articulos;
const serie = articulos
  .filter((a) => a.data.serie?.nombre === "Git por dentro")
  .sort((a, b) => a.data.serie!.orden - b.data.serie!.orden);

// Números reales del diario, calculados al compilar.
const minutos = articulos.reduce((total, a) => total + minutosDeLectura(a.body), 0);
const figuras = Object.keys(import.meta.glob("../components/figuras/*.astro")).length;
const numeros = [
  { valor: articulos.length, texto: articulos.length === 1 ? "artículo" : "artículos" },
  { valor: minutos, texto: "min de lectura" },
  { valor: figuras, texto: figuras === 1 ? "figura interactiva" : "figuras interactivas" },
];

const stack = ["Node.js", "TypeScript", "Express", "PostgreSQL", "Redis", "Kafka", "WebSockets", "Docker", "React", "Flutter"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR.fullName,
  alternateName: AUTHOR.name,
  url: SITE.url,
  jobTitle: AUTHOR.role,
  knowsAbout: ["Node.js", "TypeScript", "Express", "PostgreSQL", "Redis", "Apache Kafka", "WebSockets", "Docker", "Git", "APIs REST", "Flutter"],
  sameAs: PERFILES,
};
---

<Base title={SITE.title} jsonLd={jsonLd}>
  <section class="contenedor heroe">
    <p class="rotulo"><span class="acento">$</span> whoami</p>
    <h1>Hola, soy Nilton Taco.</h1>
    <p class="entrada">
      Desarrollador backend con <strong>Node.js</strong> y <strong>TypeScript</strong>. Me gusta entender cómo funcionan las
      herramientas por dentro, y en este diario lo explico con figuras que puedes tocar.
    </p>
    <div class="acciones">
      <a class="boton principal" href="/diario/">Leer el diario</a>
      {AUTHOR.github && <a class="boton" href={AUTHOR.github} rel="me">GitHub</a>}
      {AUTHOR.linkedin && <a class="boton" href={AUTHOR.linkedin} rel="me">LinkedIn</a>}
    </div>
  </section>

  <section class="contenedor bento" aria-label="Resumen">
    {
      destacado && (
        <article class="celda destacado" data-brillo>
          {destacado.data.imagen && (
            <Image
              class="portada"
              src={destacado.data.imagen}
              alt={destacado.data.imagenAlt ?? ""}
              widths={[480, 760, 1200]}
              sizes="(min-width: 860px) 540px, 100vw"
              loading="eager"
            />
          )}
          <div class="texto">
            <p class="rotulo">
              Último del diario · <time datetime={fechaIso(destacado.data.fecha)}>{fechaLarga(destacado.data.fecha)}</time>
            </p>
            <h2>
              <a href={urlDe(destacado)}>{destacado.data.titulo}</a>
            </h2>
            <p>{destacado.data.descripcion}</p>
          </div>
        </article>
      )
    }

    <div class="celda ahora" data-brillo>
      <p class="rotulo">Ahora</p>
      <ul>
        <li>Escribiendo la serie <strong>Git por dentro</strong>.</li>
        <li>Construyendo un <strong>Mini-Git en TypeScript</strong>, un comando a la vez.</li>
        <li>Preparando una <strong>terminal en el navegador</strong> para probar los comandos.</li>
      </ul>
    </div>

    <div class="celda numeros" data-brillo>
      <p class="rotulo">El diario en números</p>
      <dl>
        {
          numeros.map((n) => (
            <div>
              <dt>{n.texto}</dt>
              <dd>{n.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="celda quien" data-brillo>
      <p class="rotulo">Quién soy</p>
      <p>
        Soy {AUTHOR.fullName}, desarrollador backend junior en Arequipa, Perú, con 2 años construyendo sistemas en producción con
        Node.js. Me formé en Diseño y Desarrollo de Software en Tecsup.
      </p>
      <p>
        Fui líder técnico de <strong>Joya Express</strong>, una app de mototaxis para La Joya (Arequipa): lideré un equipo de 4 personas
        y diseñé su arquitectura en tiempo real con Kafka, Redis y WebSockets. Después trabajé en <strong>ViiuTech</strong> (Chile), en
        una plataforma de compensación de CO₂.
      </p>
      <ul class="stack" aria-label="Tecnologías">
        {stack.map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <div class="celda serie" data-brillo>
      <p class="rotulo">Serie · Git por dentro</p>
      <ol>
        {
          serie.map((a) => (
            <li>
              <span class="num">{String(a.data.serie!.orden).padStart(2, "0")}</span>
              <a href={urlDe(a)}>{a.data.titulo}</a>
            </li>
          ))
        }
        <li class="proximo">
          <span class="num">{String(serie.length + 1).padStart(2, "0")}</span>
          <span>Próximo: los <em>trees</em>, o cómo recuerda Git los nombres</span>
        </li>
      </ol>
    </div>
  </section>
</Base>

<script>
  // Brillo que sigue al cursor en las tarjetas (solo con ratón).
  for (const celda of document.querySelectorAll<HTMLElement>("[data-brillo]")) {
    celda.addEventListener("pointermove", (e) => {
      if (e.pointerType !== "mouse") return;
      const r = celda.getBoundingClientRect();
      celda.style.setProperty("--x", `${e.clientX - r.left}px`);
      celda.style.setProperty("--y", `${e.clientY - r.top}px`);
    });
  }
</script>

<style>
  .heroe {
    padding-top: clamp(32px, 9vw, 96px);
    padding-bottom: clamp(32px, 6vw, 64px);
  }
  .acento {
    color: var(--accent);
  }
  h1 {
    margin: 10px 0 18px;
    font-size: clamp(2.4rem, 8vw, 4.2rem);
    letter-spacing: -0.03em;
  }
  .entrada {
    max-width: 38ch;
    margin: 0;
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    line-height: 1.5;
  }
  .entrada strong {
    color: var(--strong);
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .boton {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--strong);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: transform 0.2s var(--ease);
  }
  .boton:hover {
    transform: translateY(-1px);
    color: var(--strong);
  }
  .boton.principal {
    background: var(--strong);
    color: var(--page);
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }
  .celda {
    position: relative;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--surface);
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  /* resplandor radial que sigue al cursor */
  .celda::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(360px circle at var(--x, 50%) var(--y, 0%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .celda:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
  }
  .celda:hover::before {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .celda,
    .celda:hover {
      transform: none;
    }
  }
  .celda .rotulo {
    margin: 0 0 12px;
    font-size: 12px;
  }
  .celda p:not(.rotulo) {
    margin: 0 0 10px;
    font-size: 15.5px;
  }
  .celda strong {
    color: var(--strong);
  }
  .celda ul,
  .celda ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .destacado {
    grid-column: span 4;
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  .portada {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }
  .destacado .texto {
    padding: 20px 24px 24px;
  }
  .destacado h2 {
    margin: 0 0 8px;
    font-size: 1.5rem;
  }
  .destacado h2 a {
    text-decoration: none;
  }
  /* toda la tarjeta lleva al artículo */
  .destacado h2 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .ahora,
  .numeros {
    grid-column: span 2;
  }
  .ahora li {
    position: relative;
    padding-left: 16px;
    margin-bottom: 8px;
    font-size: 15px;
    line-height: 1.5;
  }
  .ahora li::before {
    content: "›";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .numeros dl {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .numeros dl div {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: baseline;
    gap: 10px;
  }
  .numeros dd {
    margin: 0;
    min-width: 2ch;
    color: var(--strong);
    font: 700 2rem/1 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .numeros dt {
    font-size: 14.5px;
  }

  .quien,
  .serie {
    grid-column: span 3;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px !important;
  }
  .stack li {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface-2);
    font: 500 12.5px/1.6 var(--font-mono);
    color: var(--strong);
  }

  .serie li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 15.5px;
  }
  .serie li:first-child {
    border-top: 0;
    padding-top: 2px;
  }
  .serie .num {
    font: 600 13px/1 var(--font-mono);
    color: var(--accent);
  }
  .serie .proximo {
    color: var(--muted);
  }
  .serie .proximo .num {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .destacado,
    .quien,
    .serie {
      grid-column: span 2;
      grid-row: auto;
    }
    .ahora,
    .numeros {
      grid-column: span 1;
    }
  }
  @media (max-width: 560px) {
    .ahora,
    .numeros {
      grid-column: span 2;
    }
  }
</style>
